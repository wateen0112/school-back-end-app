APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_CLIENT=predis
REDIS_READ_TIMEOUT=2
REDIS_CONNECT_TIMEOUT=2
REDIS_PERSISTENT=false

MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# AI Assistant Provider: gemini | kimi
AI_PROVIDER=gemini
# When true, records with NULL school_id are visible alongside the user's school records
AI_INCLUDE_UNASSIGNED_RECORDS=false

# Gemini settings (used when AI_PROVIDER=gemini)
# NOTE: Google's Gemini API is NOT available from all countries.
# If you get "User location is not supported for the API use",
# set GEMINI_PROXY to an HTTP proxy in a supported region,
# for example: GEMINI_PROXY=http://user:pass@host:port
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_PROXY=

# Kimi / Moonshot AI settings (used when AI_PROVIDER=kimi)
KIMI_API_KEY=
KIMI_MODEL=kimi-k2.6
KIMI_BASE_URL=https://api.moonshot.ai/v1
KIMI_TEMPERATURE=1.0
KIMI_PROXY=

